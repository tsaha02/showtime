{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // See packages/shared/tsconfig.cjs.json's comment — same fix, same
    // reason: the legacy "node" value aliases to the now-removed
    // "node10" and errors on Render's fresh install. Omitted entirely;
    // `module: "commonjs"` gives tsc a correct default on its own.
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src"]
}
