DATABASE_URL="postgresql://tanmoysaha@localhost:5432/showtime"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-secret-change-me"
# Access-token lifetime only — see env.ts's comment. Staying logged in
# longer than this is handled by the (separate, not-configured-here)
# refresh token, which silently renews this in the background.
JWT_EXPIRES_IN="15m"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
NODE_ENV="development"

# Optional — only needed for the admin "Import movie" feature.
# Free key, emailed instantly, from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=""

# Optional — only needed for real email delivery (OTP verification codes,
# booking ticket emails). Free key from https://resend.com/api-keys.
# Without it, emails are logged to the server console instead of sent —
# the app never fails or blocks on a missing/misconfigured email provider.
RESEND_API_KEY=""
EMAIL_FROM="ShowTime <onboarding@resend.dev>"

# Optional — only needed for real (test-mode) Stripe payments at checkout.
# TEST keys only (sk_test_...), from https://dashboard.stripe.com/test/apikeys
# — no business verification needed for test mode. Without it, checkout
# falls back to the original mocked payment (always succeeds unless the
# client explicitly requests a simulated failure).
STRIPE_SECRET_KEY=""

# Optional — powers three GenAI features: the "What people are saying"
# AI review summary, the "describe what you want" catalog search, and
# the booking assistant chat. Groq hosts open models (Llama, etc.)
# behind a fast, OpenAI-compatible API — get a free key from
# https://console.groq.com/keys. Without it, each feature's endpoint
# responds with a clear "not configured" state rather than the app
# failing to boot or crashing on the missing key.
GROQ_API_KEY=""

# Optional — powers the "you left mid-booking" push notification (a real
# OS-level notification, works even with the tab closed). Generate a
# real pair with `npx web-push generate-vapid-keys` (from apps/api).
# Without these, the feature is simply never offered to the browser.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@showtime.dev"
